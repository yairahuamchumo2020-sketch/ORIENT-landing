---
interface Props {
  activePage?: string;
}

const { activePage } = Astro.props;

const menuItems = [
  { name: 'Главная', href: '/' },
  { name: 'Продукция', href: '/catalog' },
  { name: 'О заводе', href: '/#about' },
  { name: 'Объекты', href: '/#objects' },
  { name: 'Калькулятор', href: '/#calculator' },
  { name: 'FAQ', href: '/#faq' },
  { name: 'Контакты', href: '/contacts' }
];
---

<header id="main-header" class="header-pinned w-full bg-bg-dark border-b border-transparent transition-all duration-300">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-20 items-center justify-between">
      <!-- Логотип -->
      <a href="/" class="flex items-center group shrink-0 focus-visible:ring-2 focus-visible:ring-accent focus-visible:outline-none rounded-md transition-shadow">
        <div class="flex items-center gap-3">
          <svg class="h-9 w-9 text-[#F2EFE9] group-hover:text-accent transition-colors" viewBox="0 0 100 100" fill="currentColor" aria-hidden="true">
            <!-- Шестиугольник -->
            <polygon points="50,5 95,28 95,72 50,95 5,72 5,28" fill="none" stroke="currentColor" stroke-width="8"/>
            <!-- Внутренняя буква А в виде минималистичной стрелки/арки -->
            <path d="M50 22 L26 70 L38 70 L46 52 L54 52 L62 70 L74 70 Z M50 36 L52 44 L48 44 Z" fill="currentColor"/>
          </svg>
          <div class="flex flex-col">
            <span class="text-lg font-black tracking-tight text-[#F2EFE9] leading-none group-hover:text-accent transition-colors">
              ОРИЕНТ
            </span>
            <span class="text-[9px] font-bold text-[#D9A566] tracking-widest mt-1">
              СТРОИМ НАДЁЖНО
            </span>
          </div>
        </div>
      </a>

      <!-- Десктопное меню (центрированное) -->
      <nav class="hidden lg:flex items-center justify-center gap-4 xl:gap-6 flex-grow mx-8">
        {menuItems.map((item) => {
          const isActive = activePage === item.name || 
            (item.href === '/' && Astro.url.pathname === '/') ||
            (item.href !== '/' && Astro.url.pathname.startsWith(item.href));
          return (
            <a 
              href={item.href} 
              class={`text-xs xl:text-sm font-extrabold tracking-wide transition-colors focus-visible:ring-2 focus-visible:ring-accent focus-visible:outline-none rounded px-1.5 py-0.5 ${
                isActive 
                  ? 'text-accent' 
                  : 'text-[#A8A29B] hover:text-[#F2EFE9]'
              }`}
            >
              {item.name}
            </a>
          );
        })}
      </nav>

      <!-- Правая часть: Телефон -->
      <div class="hidden sm:flex items-center gap-2 shrink-0">
        <svg class="h-4 w-4 text-[#D9A566]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
        </svg>
        <a href="tel:88005554210" class="text-sm font-extrabold text-[#F2EFE9] hover:text-accent transition-colors focus-visible:ring-2 focus-visible:ring-accent focus-visible:outline-none rounded-md px-1.5 py-0.5">
          8 (800) 555-42-10
        </a>
      </div>

      <!-- Кнопка мобильного меню -->
      <div class="flex lg:hidden shrink-0">
        <button 
          type="button" 
          id="mobile-menu-btn"
          class="inline-flex items-center justify-center rounded-md p-2 text-[#A8A29B] hover:bg-slate-800/80 hover:text-[#F2EFE9] focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
          aria-controls="mobile-menu"
          aria-expanded="false"
        >
          <span class="sr-only">Открыть меню</span>
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Мобильное меню -->
  <div class="hidden lg:hidden bg-bg-dark border-b border-border-dark" id="mobile-menu">
    <div class="space-y-1 px-4 pb-4 pt-2">
      {menuItems.map((item) => {
        const isActive = activePage === item.name || 
          (item.href === '/' && Astro.url.pathname === '/') ||
          (item.href !== '/' && Astro.url.pathname.startsWith(item.href));
        return (
          <a 
            href={item.href} 
            class={`block rounded-md px-3 py-2 text-sm font-bold focus-visible:ring-2 focus-visible:ring-accent focus-visible:outline-none ${
              isActive 
                ? 'bg-accent/10 text-accent' 
                : 'text-[#A8A29B] hover:bg-slate-800/80 hover:text-[#F2EFE9]'
            }`}
          >
            {item.name}
          </a>
        );
      })}
      <div class="border-t border-border-dark pt-4 mt-4 pb-2">
        <div class="flex items-center gap-2 px-3">
          <svg class="h-4 w-4 text-[#D9A566]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          <a href="tel:88005554210" class="text-sm font-bold text-[#F2EFE9] hover:text-accent transition-colors focus-visible:ring-2 focus-visible:ring-accent focus-visible:outline-none rounded-md px-1.5 py-0.5">
            8 (800) 555-42-10
          </a>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  // Логика переключения мобильного меню
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  if (mobileMenuBtn && mobileMenu) {
    mobileMenuBtn.addEventListener('click', () => {
      const isExpanded = mobileMenuBtn.getAttribute('aria-expanded') === 'true';
      mobileMenuBtn.setAttribute('aria-expanded', (!isExpanded).toString());
      mobileMenu.classList.toggle('hidden');
    });
  }
</script>
