---
const projects = [
  {
    title: 'Жилой комплекс «Алые паруса»',
    type: 'Жилой комплекс',
    address: '(г. Владивосток, ул. Крыгина, 94)',
    image: '/images/obj-parusa.png'
  },
  {
    title: 'Торговый центр «Авиатор»',
    type: 'Торговый центр',
    address: '(г. Артём, ул. Фрунзе, 32а)',
    image: '/images/obj-aviator.png'
  },
  {
    title: 'Жилой комплекс «Маринист»',
    type: 'Жилой комплекс',
    address: '(г. Владивосток, ул. Фонтанная, 3)',
    image: '/images/obj-marinist.png'
  },
  {
    title: 'Бизнес-центр «Приморье»',
    type: 'Бизнес-центр',
    address: '(г. Владивосток, ул. Светланская, 51)',
    image: '/images/obj-primorye.png'
  },
  {
    title: 'Коттедж в пос. Де-Фриз',
    type: 'Частный дом',
    address: '(Надеждинский р-н, Морской проезд, 8)',
    image: '/images/obj-defriz.png'
  },
  {
    title: 'Жилой комплекс «Формат»',
    type: 'Малоэтажный жилой комплекс',
    address: '(п. Зима Южная, ул. Спортивная, 1)',
    image: '/images/obj-format.png'
  }
];
---

<!-- Тонкий оранжевый разделитель -->
<div class="h-px bg-gradient-to-r from-transparent via-accent/50 to-transparent" aria-hidden="true"></div>

<section id="objects" class="py-24 sm:py-32 bg-bg-light-alt border-b border-[#D5D3CE] reveal">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16">
      <div class="max-w-2xl">
        <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-text-dark leading-tight">
          Наши объекты
        </h2>
      </div>
      <a href="/catalog" class="mt-6 md:mt-0 inline-flex items-center justify-center rounded-md border border-[#C5C3BE] bg-white px-5 py-2.5 text-xs font-bold text-text-dark shadow-sm hover:border-accent hover:text-accent transition-colors">
        Посмотреть продукцию
      </a>
    </div>

    <!-- Сетка карточек объектов -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {projects.map((proj) => (
        <article class="relative rounded-2xl border border-[#D5D3CE] bg-white overflow-hidden shadow-md flex flex-col hover:border-accent hover:shadow-xl hover:-translate-y-1 transition-all duration-300 group">
          <!-- Фото объекта -->
          <div class="aspect-video w-full bg-stone-100 overflow-hidden relative">
            <img 
              src={proj.image} 
              alt={proj.title} 
              loading="lazy" 
              class="object-cover w-full h-full group-hover:scale-105 transition-transform duration-700"
            />
          </div>
          
          <!-- Описание -->
          <div class="p-6 flex flex-col justify-between flex-grow">
            <div>
              <h3 class="text-base font-extrabold text-text-dark group-hover:text-accent transition-colors mb-2 leading-snug">
                {proj.title}
              </h3>
            </div>
            <p class="text-xs text-text-muted-dark mt-1 font-medium">
              {proj.address}
            </p>
          </div>

          <!-- Оранжевая черта снизу при hover -->
          <span class="absolute bottom-0 left-0 right-0 h-[3px] bg-accent scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-left" aria-hidden="true"></span>
        </article>
      ))}
    </div>
  </div>
</section>
