---
const reviews = [
  {
    name: "Андрей Ш.",
    location: "коттеджный пос. Де-Фриз",
    date: "14 мая 2025",
    text: "Покупал стеновые андезитные блоки для двухэтажного дома. Каменщики сразу отметили отличную геометрию — швы получились тонкие, раствора ушло минимум. Доставили прямо на объект заводским манипулятором. Прочность блоков отличная.",
    stars: 5
  },
  {
    name: "ИП Кравченко В.А.",
    location: "г. Артём (застройщик)",
    date: "28 сентября 2025",
    text: "Сотрудничаем с заводом «Ориент» на постоянной основе. Берем перегородочные блоки и вентиляционные каналы ВБ. Геометрия идеальная, продукция пропаренная, без трещин. Документы ГОСТ и паспорта качества всегда в наличии. Работаем по безналу с НДС.",
    stars: 5
  },
  {
    name: "Михаил",
    location: "пос. Соловей-Ключ",
    date: "12 октября 2025",
    text: "Заказывал кварцевую брусчатку «Кирпичик» темно-серого цвета и бордюры. Покрытие действительно антискользящее, после дождей и первых заморозков ходить безопасно. Выглядит очень премиально. Доставка и выгрузка прошли без проблем.",
    stars: 5
  }
];
---

<!-- Тонкий оранжевый разделитель -->
<div class="h-px bg-gradient-to-r from-transparent via-accent/50 to-transparent" aria-hidden="true"></div>

<section id="reviews" class="py-24 sm:py-32 bg-bg-dark border-b border-border-dark scroll-mt-20 reveal">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mb-16 text-left">
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-[#F2EFE9] leading-tight">
        Отзывы
      </h2>
    </div>

    <!-- Сетка отзывов -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {reviews.map((review) => (
        <div class="flex flex-col justify-between rounded-xl border border-border-dark bg-bg-card p-6 sm:p-8 shadow-sm hover:border-[#A8A29B] transition-all duration-300 relative group">
          <!-- Иконка кавычек на фоне -->
          <span class="absolute top-6 right-8 text-6xl text-slate-700/30 font-serif select-none pointer-events-none group-hover:text-accent/20 transition-colors">"</span>
          
          <div>
            <!-- Звезды -->
            <div class="flex items-center gap-1 mb-5">
              {[...Array(review.stars)].map((_, i) => (
                <span class="text-accent text-sm">★</span>
              ))}
            </div>
            
            <p class="text-[#A8A29B] text-sm leading-relaxed italic mb-6">
              «{review.text}»
            </p>
          </div>

          <div class="border-t border-[#2F3540] pt-4 flex items-center justify-between">
            <div>
              <span class="font-extrabold text-[#F2EFE9] text-sm block">{review.name}</span>
              <span class="text-[11px] text-[#A8A29B]/60 block mt-0.5 font-medium">{review.location}</span>
            </div>
            <span class="text-[10px] text-[#A8A29B]/60 font-bold">{review.date}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
