---
const reviews = [
  {
    name: "Андрей Ш.",
    location: "коттеджный пос. Де-Фриз",
    date: "14 мая 2025",
    text: "Покупал стеновые андезитные блоки для двухэтажного дома. Каменщики сразу отметили отличную геометрию — швы получились тонкие, раствора ушло минимум. Доставили прямо на объект заводским манипулятором. Прочность блоков отличная.",
    stars: 5
  },
  {
    name: "ИП Кравченко В.А.",
    location: "г. Артём (застройщик)",
    date: "28 сентября 2025",
    text: "Сотрудничаем с заводом «Ориент» на постоянной основе. Берем перегородочные блоки и вентиляционные каналы ВБ. Геометрия идеальная, продукция пропаренная, без трещин. Документы ГОСТ и паспорта качества всегда в наличии. Работаем по безналу с НДС.",
    stars: 5
  },
  {
    name: "Михаил",
    location: "пос. Соловей-Ключ",
    date: "12 октября 2025",
    text: "Заказывал кварцевую брусчатку «Кирпичик» темно-серого цвета и бордюры. Покрытие действительно антискользящее, после дождей и первых заморозков ходить безопасно. Выглядит очень премиально. Доставка и выгрузка прошли без проблем.",
    stars: 5
  }
];
---

<section id="reviews" class="py-20 sm:py-24 bg-slate-900/50 border-b border-border-dark scroll-mt-20 reveal">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-bold text-accent uppercase tracking-wider block mb-4">Отзывы клиентов</span>
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Что говорят о нашей продукции
      </h2>
      <p class="mt-4 text-slate-400 text-sm">
        Нам доверяют как частные застройщики, так и крупные строительные компании Приморского края.
      </p>
    </div>

    <!-- Сетка отзывов -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {reviews.map((review) => (
        <div class="flex flex-col justify-between rounded-xl border border-border-dark bg-bg-card/50 p-6 sm:p-8 shadow-sm hover:border-slate-800 transition-all duration-300 relative group">
          <!-- Иконка кавычек на фоне -->
          <span class="absolute top-6 right-8 text-6xl text-slate-800/20 font-serif select-none pointer-events-none group-hover:text-accent/10 transition-colors">“</span>
          
          <div>
            <!-- Звезды -->
            <div class="flex items-center gap-1 mb-5">
              {[...Array(review.stars)].map((_, i) => (
                <span class="text-accent text-sm">★</span>
              ))}
            </div>
            
            <p class="text-slate-300 text-sm leading-relaxed italic mb-6">
              «{review.text}»
            </p>
          </div>

          <div class="border-t border-slate-800/60 pt-4 flex items-center justify-between">
            <div>
              <span class="font-bold text-white text-sm block">{review.name}</span>
              <span class="text-[11px] text-slate-500 block mt-0.5">{review.location}</span>
            </div>
            <span class="text-[10px] text-slate-600 font-medium">{review.date}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
