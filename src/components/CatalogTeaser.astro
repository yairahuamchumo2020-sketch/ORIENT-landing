---
const productCategories = [
  {
    name: 'Стеновой блок',
    href: '/catalog/block-wall',
    image: '/images/products/block-wall.png'
  },
  {
    name: 'Перегородочный блок',
    href: '/catalog/block-partition-wide',
    image: '/images/products/block-partition-wide.png'
  },
  {
    name: 'Вентиляционный блок',
    href: '/catalog/vent-vb1',
    image: '/images/products/vent-vb1.png'
  },
  {
    name: 'Бордюрный камень',
    href: '/catalog/curb-br80',
    image: '/images/products/curb-br80.png'
  },
  {
    name: 'Брусчатка',
    href: '/catalog/paving-brick',
    image: '/images/products/paving-brick.png'
  }
];
---

<!-- Тонкий оранжевый разделитель -->
<div class="h-px bg-gradient-to-r from-transparent via-accent/50 to-transparent" aria-hidden="true"></div>

<section id="popular-products" class="py-24 sm:py-32 bg-bg-light border-b border-[#D5D3CE] scroll-mt-20 reveal">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
      <div>
        <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-text-dark leading-tight text-balance">
          Продукция завода Ориент
        </h2>
        <p class="mt-4 text-text-muted-dark text-sm max-w-2xl font-medium">
          Производим качественные строительные материалы из экологически чистого вулканического сырья Приморья. Все изделия сертифицированы по ГОСТ.
        </p>
      </div>
      <div class="mt-6 md:mt-0">
        <a 
          href="/catalog" 
          class="inline-flex items-center gap-2 text-sm font-bold text-accent hover:text-accent-hover focus-visible:ring-2 focus-visible:ring-accent focus-visible:outline-none rounded px-1.5 py-0.5 transition-colors group"
        >
          Смотреть всю продукцию
          <span class="group-hover:translate-x-1 transition-transform">→</span>
        </a>
      </div>
    </div>

    <!-- Сетка продукции -->
    <div class="space-y-6 max-w-5xl">
      <!-- Ряд 1: Стеновой блок, перегородочный блок, вентиляционный блок -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl">
        {productCategories.slice(0, 3).map((category) => (
          <a 
            href={category.href}
            class="relative flex flex-col overflow-hidden rounded-xl border border-[#D5D3CE] bg-white hover:border-accent focus-visible:ring-2 focus-visible:ring-accent focus-visible:outline-none transition-all duration-300 group shadow-md hover:shadow-xl hover:-translate-y-0.5"
          >
            <div class="aspect-[16/10] bg-stone-100 flex items-center justify-center relative overflow-hidden p-0">
              <img 
                src={category.image} 
                alt={category.name} 
                width="280"
                height="175"
                class="object-cover w-full h-full drop-shadow-[0_10px_20px_rgba(0,0,0,0.15)] group-hover:scale-105 transition-transform duration-500 select-none pointer-events-none"
                loading="lazy"
              />
            </div>
            <div class="p-4 border-t border-[#E5E3DE] text-center bg-white group-hover:bg-stone-50 transition-colors">
              <h3 class="text-xs sm:text-sm font-bold text-text-dark group-hover:text-accent transition-colors leading-tight">
                {category.name}
              </h3>
            </div>
            <!-- Оранжевая черта снизу при hover -->
            <span class="absolute bottom-0 left-0 right-0 h-[3px] bg-accent scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-left" aria-hidden="true"></span>
          </a>
        ))}
      </div>

      <!-- Ряд 2: Бордюрный камень, брусчатка -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-2xl">
        {productCategories.slice(3, 5).map((category) => (
          <a 
            href={category.href}
            class="relative flex flex-col overflow-hidden rounded-xl border border-[#D5D3CE] bg-white hover:border-accent focus-visible:ring-2 focus-visible:ring-accent focus-visible:outline-none transition-all duration-300 group shadow-md hover:shadow-xl hover:-translate-y-0.5"
          >
            <div class="aspect-[16/10] bg-stone-100 flex items-center justify-center relative overflow-hidden p-0">
              <img 
                src={category.image} 
                alt={category.name} 
                width="280"
                height="175"
                class="object-cover w-full h-full drop-shadow-[0_10px_20px_rgba(0,0,0,0.15)] group-hover:scale-105 transition-transform duration-500 select-none pointer-events-none"
                loading="lazy"
              />
            </div>
            <div class="p-4 border-t border-[#E5E3DE] text-center bg-white group-hover:bg-stone-50 transition-colors">
              <h3 class="text-xs sm:text-sm font-bold text-text-dark group-hover:text-accent transition-colors leading-tight">
                {category.name}
              </h3>
            </div>
            <!-- Оранжевая черта снизу при hover -->
            <span class="absolute bottom-0 left-0 right-0 h-[3px] bg-accent scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-left" aria-hidden="true"></span>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>
