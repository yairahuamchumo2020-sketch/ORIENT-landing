---
---

<section class="relative overflow-hidden bg-bg-dark py-16 sm:py-20 lg:py-0 lg:min-h-[calc(100vh-80px)] lg:flex lg:items-stretch border-b border-border-dark">
  <!-- Мягкий градиентный свет на фоне для тёмной темы -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(201,98,45,0.08),transparent_50%)]"></div>
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom_left,rgba(217,165,102,0.06),transparent_50%)]"></div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10 w-full flex items-stretch">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 items-stretch w-full">
      <!-- Текст -->
      <div class="lg:col-span-7 flex flex-col justify-center py-12">
        <h1 class="text-4xl sm:text-6xl xl:text-7xl font-black tracking-tight mb-6 leading-[1.1] text-left text-balance">
          <span class="text-[#F2EFE9] block">Высокопрочные</span>
          <span class="text-[#F2EFE9] block">андезитные блоки</span>
          <span class="text-accent block">от завода ОРИЕНТ</span>
        </h1>
        <p class="text-lg sm:text-xl text-[#A8A29B] mb-8 leading-relaxed max-w-xl font-medium">
          Производим андезитные блоки высшего качества для надёжного и долговечного строительства.
        </p>

        <!-- CTA кнопки в правильном порядке -->
        <div class="flex flex-wrap gap-4 mb-12 sm:mb-16">
          <a 
            href="/catalog" 
            class="inline-flex h-12 sm:h-14 items-center justify-center rounded-md border border-[#F2EFE9] bg-transparent px-6 sm:px-8 text-xs sm:text-sm font-extrabold text-[#F2EFE9] shadow-sm hover:bg-[#23272E] hover:scale-[1.02] active:scale-[0.98] focus-visible:ring-2 focus-visible:ring-accent focus-visible:outline-none transition-all"
          >
            Смотреть продукцию
          </a>
          <a 
            href="/contacts" 
            class="inline-flex h-12 sm:h-14 items-center justify-center rounded-md border border-transparent bg-accent px-6 sm:px-8 text-xs sm:text-sm font-extrabold text-white shadow-sm hover:bg-accent-hover hover:scale-[1.02] active:scale-[0.98] focus-visible:ring-2 focus-visible:ring-[#F2EFE9] focus-visible:outline-none transition-all"
          >
            Получить предложение
          </a>
        </div>

        <!-- Горизонтальная линейка преимуществ с вертикальными разделителями -->
        <div class="flex flex-row items-stretch justify-between pt-8 border-t border-border-dark w-full gap-2 sm:gap-4">
          <!-- 1 -->
          <div class="flex flex-col items-center text-center gap-2 flex-1 min-w-0">
            <svg class="h-10 w-10 sm:h-12 sm:w-12 text-[#D9A566] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
            </svg>
            <div>
              <p class="text-xs sm:text-sm font-extrabold text-white leading-tight">Работаем</p>
              <p class="text-xs sm:text-sm text-white/90 mt-0.5 font-semibold leading-tight">с 2005 года</p>
            </div>
          </div>
          
          <!-- Разделитель -->
          <div class="hidden sm:block w-px bg-border-dark shrink-0 my-1 self-center h-10"></div>

          <!-- 2 -->
          <div class="flex flex-col items-center text-center gap-2 flex-1 min-w-0">
            <svg class="h-10 w-10 sm:h-12 sm:w-12 text-[#D9A566] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75m3-3h.75m-.75 3h.75" />
            </svg>
            <div>
              <p class="text-xs sm:text-sm font-extrabold text-white leading-tight">Собственное</p>
              <p class="text-xs sm:text-sm text-white/90 mt-0.5 font-semibold leading-tight">производство</p>
            </div>
          </div>

          <!-- Разделитель -->
          <div class="hidden sm:block w-px bg-border-dark shrink-0 my-1 self-center h-10"></div>

          <!-- 3 -->
          <div class="flex flex-col items-center text-center gap-2 flex-1 min-w-0">
            <svg class="h-10 w-10 sm:h-12 sm:w-12 text-[#D9A566] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3 L20 9.5 L17 19 L7 19 L4 9.5 Z M12 3 L12 19 M4 9.5 L20 9.5 M7 19 L12 9.5 L17 19" />
            </svg>
            <div>
              <p class="text-xs sm:text-sm font-extrabold text-white leading-tight">100% натуральный</p>
              <p class="text-xs sm:text-sm text-white/90 mt-0.5 font-semibold leading-tight">андезит</p>
            </div>
          </div>

          <!-- Разделитель -->
          <div class="hidden sm:block w-px bg-border-dark shrink-0 my-1 self-center h-10"></div>

          <!-- 4 -->
          <div class="flex flex-col items-center text-center gap-2 flex-1 min-w-0">
            <svg class="h-10 w-10 sm:h-12 sm:w-12 text-[#D9A566] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124l-.304-4.822a1.5 1.5 0 00-1.49-1.404H14.25M12 16.5V6.75A2.25 2.25 0 009.75 4.5H3.75A2.25 2.25 0 001.5 6.75v10.5a2.25 2.25 0 002.25 2.25h15a2.25 2.25 0 002.25-2.25V14.25m-15 0h15" />
            </svg>
            <div>
              <p class="text-xs sm:text-sm font-extrabold text-white leading-tight">Доставка по</p>
              <p class="text-xs sm:text-sm text-white/90 mt-0.5 font-semibold leading-tight">Приморскому краю</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Изображение блоков справа -->
      <div class="lg:col-span-5 relative flex items-end justify-center lg:justify-end h-full w-full self-end">
        <img 
          src="/images/block-wall-pallet.png" 
          alt="Высокопрочные андезитные блоки на поддоне ОРИЕНТ" 
          width="580"
          height="540"
          class="object-contain object-bottom w-auto lg:h-[calc(100vh-80px)] lg:max-h-[calc(100vh-80px)] h-[400px] sm:h-[500px] drop-shadow-[0_25px_50px_rgba(0,0,0,0.6)] select-none pointer-events-none"
          loading="eager"
        />
      </div>
    </div>
  </div>
</section>
