---
import { Image } from 'astro:assets';
import factoryProcessing from '../assets/images/factory-processing.png';
const baseUrl = import.meta.env.BASE_URL;
---

<!-- Тонкий оранжевый разделитель -->
<div class="h-px bg-gradient-to-r from-transparent via-accent/50 to-transparent" aria-hidden="true"></div>

<section id="about" class="py-24 sm:py-32 bg-bg-dark border-b border-border-dark relative reveal">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 sm:gap-16 items-center">
      
      <!-- Левая колонка: Описание -->
      <div class="order-1">
        <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-[#F2EFE9] leading-tight mb-6 text-balance">
          О заводе
        </h2>

        <!-- Акцентная статистика крупными оранжевыми цифрами -->
        <div class="flex flex-wrap gap-8 mb-8">
          <div>
            <p class="text-5xl font-black text-accent leading-none">18</p>
            <p class="text-xs text-[#A8A29B] mt-1.5 font-medium uppercase tracking-wider">лет на рынке</p>
          </div>
          <div>
            <p class="text-5xl font-black text-accent leading-none">F-50</p>
            <p class="text-xs text-[#A8A29B] mt-1.5 font-medium uppercase tracking-wider">морозостойкость</p>
          </div>
          <div>
            <p class="text-5xl font-black text-accent leading-none">12+</p>
            <p class="text-xs text-[#A8A29B] mt-1.5 font-medium uppercase tracking-wider">типоразмеров</p>
          </div>
        </div>

        <p class="text-[#A8A29B] text-sm sm:text-base leading-relaxed mb-6">
          Мы исключили человеческий фактор из процесса прессования. Автоматизация импортных линий обеспечивает стабильно высокую плотность блоков, точную дозировку компонентов и идеальную геометрия граней.
        </p>

        <!-- Характеристики производства -->
        <div class="space-y-6">
          <div class="flex gap-4">
            <span class="text-2xl text-accent" aria-hidden="true">🌋</span>
            <div>
              <h3 class="text-base font-bold text-[#F2EFE9] mb-1">Вулканический андезит</h3>
              <p class="text-xs text-[#A8A29B] leading-relaxed">
                Использование прочного вулканического заполнителя снижает теплопроводность блока до 0.46 и обеспечивает долговечность стен.
              </p>
            </div>
          </div>

          <div class="flex gap-4">
            <span class="text-2xl text-accent" aria-hidden="true">💨</span>
            <div>
              <h3 class="text-base font-bold text-[#F2EFE9] mb-1">Паровые автоматические камеры</h3>
              <p class="text-xs text-[#A8A29B] leading-relaxed">
                Пропаривание в камерах гарантирует равномерный набор прочности изделий. Паспортная прочность достигается через 28 дней.
              </p>
            </div>
          </div>

          <div class="flex gap-4">
            <span class="text-2xl text-accent" aria-hidden="true">🧱</span>
            <div>
              <h3 class="text-base font-bold text-[#F2EFE9] mb-1">Цемент марки 500</h3>
              <p class="text-xs text-[#A8A29B] leading-relaxed">
                Мы используем только качественный российский портландцемент 42.5Н без примесей для максимальной прочности на сжатие.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Правая колонка: Изображение, плавно сливающееся с фоном -->
      <div class="relative order-2 group">
        <!-- Бейдж F-50 — левый верхний угол -->
        <div class="absolute -top-4 -left-4 hidden sm:block bg-bg-card border border-accent/40 rounded-xl p-4 shadow-xl z-30">
          <p class="text-2xl font-black text-accent leading-none">F-50</p>
          <p class="text-[10px] text-[#A8A29B] mt-1 font-medium leading-tight">Морозо-<br>стойкость</p>
        </div>

        <div class="w-full aspect-video rounded-2xl overflow-hidden shadow-2xl relative">
          <!-- Реальное изображение цеха с прозрачностью и наложением -->
          <Image 
            src={factoryProcessing} 
            alt="Линия автоматизированного пропаривания блоков" 
            width={640}
            height={360}
            quality="80"
            class="object-cover w-full h-full opacity-60 group-hover:scale-105 transition-transform duration-700 select-none pointer-events-none"
            loading="lazy"
          />
          <!-- Радиальный градиент для слияния краев изображения с фоном секции #1A1D21 -->
          <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,transparent_45%,#1A1D21_100%)] z-20"></div>
        </div>
        
        <!-- Абсолютный бейдж ГОСТ — правый нижний угол -->
        <div class="absolute -bottom-6 -right-6 hidden sm:block bg-accent rounded-xl p-6 shadow-2xl border border-accent/20 max-w-[200px] z-30">
          <p class="text-3xl font-black text-white">ГОСТ</p>
          <p class="text-xs text-white/80 mt-1 leading-relaxed">Вся продукция сертифицирована и проходит радиологический контроль.</p>
        </div>
      </div>

    </div>
  </div>
</section>
