---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Контакты завода «ОРИЕНТ» в Приморском крае" 
  description="Контакты производителя андезитных блоков и кварцевой брусчатки завода «ОРИЕНТ». Адрес самовывоза: пос. Раздольное, ул. Гастелло, 25 (Надеждинский район). Телефон: +7 (423) 255-18-18."
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12">
    <!-- Заголовок страницы -->
    <div class="border-b border-[#2F3540] pb-8 mb-12">
      <h1 class="text-3xl font-extrabold tracking-tight text-[#F2EFE9] sm:text-4xl">Контакты</h1>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
      <!-- Информация и реквизиты -->
      <div>
        <h2 class="text-xl font-extrabold text-[#F2EFE9] mb-6">Отдел продаж и производство</h2>
        <div class="space-y-6 text-sm text-[#A8A29B] font-medium">
          <div class="flex items-start gap-4">
            <span class="text-accent text-lg" aria-hidden="true">📍</span>
            <div>
              <p class="font-extrabold text-[#F2EFE9]">Адрес производства и самовывоза:</p>
              <p class="mt-1">Приморский край, Надеждинский район, пос. Раздольное, ул. Гастелло, 25</p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <span class="text-accent text-lg" aria-hidden="true">📞</span>
            <div>
              <p class="font-extrabold text-[#F2EFE9]">Телефон:</p>
              <p class="mt-1 text-base">
                <a href="tel:+74232551818" class="hover:text-accent font-bold text-[#F2EFE9] focus-visible:ring-2 focus-visible:ring-accent focus-visible:outline-none rounded px-1 transition-colors">+7 (423) 255-18-18</a>
              </p>
              <p class="text-xs text-[#A8A29B]/60 mt-0.5">Звонки принимаются с 8:00 до 18:00 (пн-сб)</p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <span class="text-accent text-lg" aria-hidden="true">✉️</span>
            <div>
              <p class="font-extrabold text-[#F2EFE9]">Электронная почта:</p>
              <p class="mt-1">
                <a href="mailto:sales@orient-andezit.ru" class="hover:text-accent font-bold focus-visible:ring-2 focus-visible:ring-accent focus-visible:outline-none rounded px-1 transition-colors text-[#F2EFE9]">sales@orient-andezit.ru</a>
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <span class="text-accent text-lg" aria-hidden="true">💼</span>
            <div>
              <p class="font-extrabold text-[#F2EFE9]">Реквизиты компании:</p>
              <p class="mt-1 leading-relaxed text-xs text-[#A8A29B]/80">
                ООО «ОРИЕНТ»<br />
                ИНН: 2521000000 / КПП: 252101001<br />
                ОГРН: 1052500000000<br />
                Юридический адрес: Приморский край, Надеждинский район, п. Раздольное
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Форма обратной связи -->
      <div id="callback-form" class="rounded-2xl border border-border-dark bg-bg-card p-8 shadow-sm">
        <h2 class="text-xl font-extrabold text-[#F2EFE9] mb-2">Оставить заявку</h2>
        <p class="text-[#A8A29B] text-xs mb-6 font-medium">Заполните форму, и мы свяжемся с вами в течение 30 минут для расчета сметы.</p>

        <!-- Пока просто разметка формы, AJAX будет подключен далее -->
        <form class="space-y-4">
          <div>
            <label for="name" class="block text-xs font-bold text-[#A8A29B] mb-1.5">Ваше имя</label>
            <input 
              type="text" 
              id="name" 
              name="name" 
              required 
              placeholder="Иван"
              autocomplete="name"
              class="w-full rounded-md border border-[#2F3540] bg-bg-dark px-3 py-2 text-sm text-[#F2EFE9] placeholder-[#A8A29B]/40 focus:border-accent focus-visible:ring-2 focus-visible:ring-accent focus:outline-none transition-colors shadow-sm"
            />
          </div>

          <div>
            <label for="phone" class="block text-xs font-bold text-[#A8A29B] mb-1.5">Номер телефона</label>
            <input 
              type="tel" 
              id="phone" 
              name="phone" 
              required 
              placeholder="+7 (999) 000-00-00"
              autocomplete="tel"
              class="w-full rounded-md border border-[#2F3540] bg-bg-dark px-3 py-2 text-sm text-[#F2EFE9] placeholder-[#A8A29B]/40 focus:border-accent focus-visible:ring-2 focus-visible:ring-accent focus:outline-none transition-colors shadow-sm"
            />
          </div>

          <div>
            <label for="message" class="block text-xs font-bold text-[#A8A29B] mb-1.5">Комментарий (какой объем блоков/брусчатки нужен)</label>
            <textarea 
              id="message" 
              name="message" 
              rows="3" 
              placeholder="Интересует стеновой блок, примерно 40 куб. м. Нужна доставка в Артем."
              class="w-full rounded-md border border-[#2F3540] bg-bg-dark px-3 py-2 text-sm text-[#F2EFE9] placeholder-[#A8A29B]/40 focus:border-accent focus-visible:ring-2 focus-visible:ring-accent focus:outline-none transition-colors shadow-sm"
            ></textarea>
          </div>

          <button 
            type="submit" 
            class="w-full inline-flex items-center justify-center rounded-md bg-accent px-4 py-2.5 text-sm font-bold text-white shadow-sm hover:bg-accent-hover focus-visible:ring-2 focus-visible:ring-[#F2EFE9] focus-visible:outline-none transition-colors cursor-pointer"
          >
            Отправить заявку
          </button>
        </form>
      </div>
    </div>

    <!-- Интерактивная карта -->
    <div class="mt-16 rounded-2xl border border-border-dark bg-bg-card p-2 shadow-sm overflow-hidden aspect-video max-h-[500px]">
      <iframe 
        src="https://yandex.ru/map-widget/v1/?ll=131.905%2C43.608&z=16&mode=search&text=%D0%BF%D0%BE%D1%81.+%D0%A0%D0%B0%D0%B7%D0%B4%D0%BE%D0%BB%D1%8C%D0%BD%D0%BE%D0%B5+%D1%83%D0%BB.+%D0%93%D0%B0%D1%81%D1%82%D0%B5%D0%BB%D0%BB%D0%BE+25" 
        title="Интерактивная карта проезда к заводу Ориент, пос. Раздольное, ул. Гастелло, 25"
        width="100%" 
        height="100%" 
        frameborder="0" 
        allowfullscreen="true" 
        style="position:relative;"
        class="rounded-xl border border-border-dark"
      ></iframe>
    </div>

    <!-- Скрипт предотвращения автоскролла и принудительной прокрутки наверх -->
    <script is:inline>
      if ('scrollRestoration' in history) {
        history.scrollRestoration = 'manual';
      }
      window.scrollTo(0, 0);
      document.addEventListener('DOMContentLoaded', () => {
        window.scrollTo(0, 0);
      });
      window.addEventListener('load', () => {
        window.scrollTo(0, 0);
      });
    </script>
  </div>
</BaseLayout>
