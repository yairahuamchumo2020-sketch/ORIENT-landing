---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Gallery from '../components/Gallery.astro';
import CatalogTeaser from '../components/CatalogTeaser.astro';
import Calculator from '../components/Calculator.jsx';
import Reviews from '../components/Reviews.astro';
import FAQ from '../components/FAQ.astro';
---

<BaseLayout 
  title="Производитель андезитных блоков и брусчатки в Приморском крае" 
  description="Завод «ОРИЕНТ» — производство и поставка стеновых андезитобазальтовых блоков, вентблоков и кварцевой брусчатки напрямую с завода. Работаем с 2005 года во Владивостоке."
  activePage="Главная"
>
  <!-- Hero Секция (УТП, первый экран) -->
  <Hero />

  <!-- Блок "О производстве" (автоматизация, материалы) -->
  <About />

  <!-- Примеры объектов (реализованные проекты) -->
  <Gallery />

  <!-- Тизер каталога продукции -->
  <CatalogTeaser />

  <!-- Интерактивный калькулятор блоков (React остров) -->
  <section id="calculator" class="py-20 sm:py-24 bg-bg-dark border-b border-border-dark scroll-mt-20 reveal">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="text-xs font-bold text-accent uppercase tracking-wider block mb-4">Онлайн расчет</span>
        <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
          Калькулятор расчета строительных блоков
        </h2>
        <p class="mt-4 text-slate-400 text-sm">
          Укажите габариты ваших стен, выберите тип блока, и калькулятор покажет необходимый объем материалов и количество поддонов.
        </p>
      </div>

      <Calculator client:visible />
    </div>
  </section>

  <!-- Блок отзывов клиентов -->
  <Reviews />

  <!-- Блок часто задаваемых вопросов (FAQ) -->
  <FAQ />

  <!-- Секция быстрой обратной связи -->
  <section class="py-20 sm:py-24 border-t border-border-dark bg-slate-900/50 reveal">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl mb-4">
          Готовы начать строительство?
        </h2>
        <p class="text-slate-400 text-sm sm:text-base mb-8 max-w-2xl mx-auto leading-relaxed">
          Оставьте свои контактные данные, и мы подготовим для вас индивидуальное коммерческое предложение с точной стоимостью доставки прямо на ваш объект.
        </p>
        <div class="flex justify-center">
          <a 
            href="/contacts#callback-form" 
            class="inline-flex items-center justify-center rounded-md bg-accent px-6 py-3.5 text-sm font-bold text-white shadow-sm hover:bg-accent-hover hover:scale-[1.02] active:scale-[0.98] transition-all"
          >
            Связаться с отделом продаж
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
