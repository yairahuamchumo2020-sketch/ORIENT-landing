---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Gallery from '../components/Gallery.astro';
import CatalogTeaser from '../components/CatalogTeaser.astro';
import Calculator from '../components/Calculator.jsx';
import Reviews from '../components/Reviews.astro';
import FAQ from '../components/FAQ.astro';
---

<BaseLayout 
  title="Производитель андезитных блоков и брусчатки в Приморском крае" 
  description="Завод «ОРИЕНТ» — производство и поставка стеновых андезитобазальтовых блоков, вентблоков и кварцевой брусчатки напрямую с завода. Работаем с 2005 года во Владивостоке."
  activePage="Главная"
>
  <!-- 1. Hero — тёмный -->
  <Hero />

  <!-- 2. Продукция — светлый (разделитель внутри компонента) -->
  <CatalogTeaser />

  <!-- 3. О заводе — тёмный (разделитель внутри компонента) -->
  <About />

  <!-- 4. Наши объекты — светлый (разделитель внутри компонента) -->
  <Gallery />

  <!-- 5. Отзывы — тёмный (разделитель внутри компонента) -->
  <Reviews />

  <!-- Тонкий оранжевый разделитель перед калькулятором -->
  <div class="h-px bg-gradient-to-r from-transparent via-accent/50 to-transparent" aria-hidden="true"></div>

  <!-- 6. Калькулятор — светлый -->
  <section id="calculator" class="py-24 sm:py-32 bg-bg-light border-b border-[#D5D3CE] scroll-mt-20 reveal">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="w-full max-w-5xl mb-12 text-left">
        <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-text-dark leading-tight">
          Калькулятор расчёта строительных блоков
        </h2>
        <p class="mt-4 text-text-muted-dark text-sm font-medium">
          Укажите габариты ваших стен, выберите тип блока, и калькулятор покажет необходимый объем материалов и количество поддонов.
        </p>
      </div>

      <Calculator client:visible />
    </div>
  </section>

  <!-- 7. FAQ — тёмный (разделитель внутри компонента) -->
  <FAQ />

  <!-- Тонкий оранжевый разделитель перед CTA -->
  <div class="h-px bg-gradient-to-r from-transparent via-accent/60 to-transparent" aria-hidden="true"></div>

  <!-- 8. CTA — тёмно-оранжевый градиент, кнопка справа -->
  <section class="py-24 sm:py-32 bg-[linear-gradient(135deg,#3D1F10_0%,#2A1500_40%,#1A1D21_100%)] reveal">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-8">
        <div class="max-w-2xl">
          <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-[#F2EFE9] leading-tight mb-4">
            Готовы начать строительство?
          </h2>
          <p class="text-[#A8A29B] text-sm sm:text-base leading-relaxed font-medium">
            Оставьте свои контактные данные, и мы подготовим для вас индивидуальное коммерческое предложение с точной стоимостью доставки прямо на ваш объект.
          </p>
        </div>
        <div class="shrink-0">
          <a 
            href="/contacts" 
            class="inline-flex items-center justify-center rounded-md bg-accent px-8 py-4 text-sm font-bold text-white shadow-lg hover:bg-accent-hover hover:scale-[1.02] active:scale-[0.98] transition-all whitespace-nowrap"
          >
            Оставить заявку
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
