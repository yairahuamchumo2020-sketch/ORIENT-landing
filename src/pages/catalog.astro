---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CatalogView from '../components/CatalogView.jsx';

// Получаем все товары из контентной коллекции
const allProducts = await getCollection('products');
---

<BaseLayout 
  title="Каталог продукции: блоки, брусчатка, бордюры" 
  description="Каталог строительных материалов завода «ОРИЕНТ»: стеновые и перегородочные андезитные блоки, вентиляционные блоки, вибропрессованная кварцевая брусчатка, бордюры. Цены от производителя."
  activePage="Продукция"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12">
    <!-- Заголовок каталога -->
    <div class="border-b border-border-dark pb-8 mb-8">
      <h1 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">Каталог продукции</h1>
      <p class="mt-2 text-sm text-slate-400">
        Прямые поставки высококачественных вибропрессованных изделий с Раздольненского завода «Ориент».
      </p>
    </div>

    <!-- Интерактивный React-остров для фильтрации и отображения сетки -->
    <CatalogView client:load allProducts={allProducts} />
  </div>
</BaseLayout>
